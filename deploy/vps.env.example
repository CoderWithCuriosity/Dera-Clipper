# /etc/clipper/clipper.env  (mode: 0600, owner: clipper)
CLIPPER_MODE=vps
CLIPPER_HOST=127.0.0.1
CLIPPER_PORT=8000
CLIPPER_DATA_DIR=/var/lib/clipper
# Keep this secret, and keep a separate copy. Without it, saved API keys cannot be decrypted.
CLIPPER_MASTER_KEY=replace-with-a-long-random-string
CLIPPER_ADMIN_EMAIL=you@example.com
CLIPPER_ALLOW_REGISTRATION=false
# Local Whisper on a 4 GB, 2 vCPU VPS. Use CLIPPER_TRANSCRIPTION_ENGINE=cloud on smaller plans.
CLIPPER_WHISPER_MODEL=base
# Optional PostgreSQL for more users (needs: pip install "psycopg[binary]")
# CLIPPER_DATABASE_URL=postgresql://clipper:password@localhost/clipper
# Optional S3-compatible storage (AWS S3, MinIO, Backblaze B2)
# CLIPPER_STORAGE=s3
# CLIPPER_S3_BUCKET=your-bucket
# CLIPPER_S3_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
# CLIPPER_S3_REGION=us-west-004
